# ── SMTP (contact form) ───────────────────────────────────────────────────────
# Configure your email provider here. Gmail example shown; use an App Password
# (not your account password) if using Gmail with 2FA enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Site URL (used for sitemap, canonical URLs, and structured data) ──────────
NEXT_PUBLIC_SITE_URL=https://entrenacondiego.com

# ── Business contact info (used for LocalBusiness JSON-LD schema) ─────────────
# Add your public phone number here to enable it in structured data / rich results
NEXT_PUBLIC_BUSINESS_PHONE=+34 600 000 000

# ── Analytics (optional) ─────────────────────────────────────────────────────
# Uncomment and fill in if you add Plausible Analytics
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=entrenacondiego.com

# ── Google / Firebase (Genkit AI — not used in production UI) ─────────────────
# Only needed if src/ai/ flows are actively used
# GOOGLE_GENAI_API_KEY=
